---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Skills from '../../components/Skills.astro';
import Experience from '../../components/Experience.astro';
import Certifications from '../../components/Certifications.astro';
import Education from '../../components/Education.astro';
import Contact from '../../components/Contact.astro';
import { translations } from '../../data/i18n';

const lang = 'en';
const t = translations[lang].meta;
---

<Layout lang={lang} title={t.title} description={t.description}>
  <!-- Hero Section -->
  <Hero currentLang={lang} />

  <!-- About / Executive Summary Section -->
  <About currentLang={lang} />

  <!-- Strategic Skills & Tools Section -->
  <Skills currentLang={lang} />

  <!-- Career Experience & Track Record Section -->
  <Experience currentLang={lang} />

  <!-- Verified Certifications Section -->
  <Certifications currentLang={lang} />

  <!-- Education & Leadership Section -->
  <Education currentLang={lang} />

  <!-- High-Converting Contact & Inbound Section -->
  <Contact currentLang={lang} />
</Layout>
