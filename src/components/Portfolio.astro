---
import { portfolioData, type PortfolioCategory } from '../data/portfolio';
import { translations, type Locale } from '../data/i18n';

interface Props {
  currentLang?: Locale;
}

const { currentLang = 'id' } = Astro.props;
const t = translations[currentLang].portfolio;

const categoryConfig: Record<PortfolioCategory, {
  icon: string;
  badgeClass: string;
  titleHoverClass: string;
  linkClass: string;
  label: string;
}> = {
  'website': {
    icon: '💻',
    badgeClass: 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/20',
    titleHoverClass: 'group-hover:text-indigo-600 dark:group-hover:text-indigo-400',
    linkClass: 'text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300',
    label: t.categories.website
  },
  'study-case': {
    icon: '📋',
    badgeClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20',
    titleHoverClass: 'group-hover:text-emerald-600 dark:group-hover:text-emerald-400',
    linkClass: 'text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300',
    label: t.categories.studyCase
  },
  'seo': {
    icon: '🔍',
    badgeClass: 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border-cyan-500/20',
    titleHoverClass: 'group-hover:text-cyan-600 dark:group-hover:text-cyan-400',
    linkClass: 'text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300',
    label: t.categories.seo
  },
  'ads': {
    icon: '🎯',
    badgeClass: 'bg-violet-500/10 text-violet-700 dark:text-violet-300 border-violet-500/20',
    titleHoverClass: 'group-hover:text-violet-600 dark:group-hover:text-violet-400',
    linkClass: 'text-violet-600 dark:text-violet-400 hover:text-violet-700 dark:hover:text-violet-300',
    label: t.categories.ads
  }
};

const categoryCounts = {
  all: portfolioData.length,
  website: portfolioData.filter(p => p.category === 'website').length,
  'study-case': portfolioData.filter(p => p.category === 'study-case').length,
  seo: portfolioData.filter(p => p.category === 'seo').length,
  ads: portfolioData.filter(p => p.category === 'ads').length,
};

const homeUrl = currentLang === 'en' ? '/en/' : '/';
---

<section id="portfolio" class="py-12 sm:py-20 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Navigation: Back to Home -->
    <div class="mb-10 reveal-on-scroll flex items-center justify-between">
      <a 
        href={homeUrl} 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-700/60 transition-all hover:border-indigo-500/40"
      >
        <span>{t.backToHome}</span>
      </a>
      <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
        Total: <strong class="text-indigo-600 dark:text-indigo-400">{categoryCounts.all}</strong> {t.projectCount}
      </span>
    </div>

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-widest mb-3 border border-indigo-500/20">
        {t.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t.title}<span class="text-gradient-accent">{t.titleAccent}</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 mt-4 text-sm sm:text-base lg:text-lg leading-relaxed">
        {t.subtitle}
      </p>

      <!-- Stats Summary Breakdown Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-4 mt-6">
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 text-xs font-medium border border-indigo-500/20">
          💻 <span><strong>{categoryCounts.website}</strong> {t.categories.website}</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 text-xs font-medium border border-emerald-500/20">
          📋 <span><strong>{categoryCounts['study-case']}</strong> {t.categories.studyCase}</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 text-xs font-medium border border-cyan-500/20">
          🔍 <span><strong>{categoryCounts.seo}</strong> {t.categories.seo}</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-violet-500/10 text-violet-700 dark:text-violet-300 text-xs font-medium border border-violet-500/20">
          🎯 <span><strong>{categoryCounts.ads}</strong> {t.categories.ads}</span>
        </div>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="max-w-3xl mx-auto mb-10 space-y-4 reveal-on-scroll">
      <!-- Search Input -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          type="text" 
          id="portfolio-search-input"
          placeholder={t.searchPlaceholder} 
          class="w-full pl-10 pr-10 py-3 rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all shadow-xs"
        />
        <button 
          id="portfolio-search-clear"
          type="button"
          class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hidden cursor-pointer"
          title="Clear search"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5" id="portfolio-filters">
        <button 
          type="button"
          data-filter="all" 
          class="portfolio-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-indigo-600 dark:bg-indigo-500 text-white shadow-md shadow-indigo-500/20 transition-all cursor-pointer"
        >
          {t.categories.all} ({categoryCounts.all})
        </button>
        <button 
          type="button"
          data-filter="website" 
          class="portfolio-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all cursor-pointer"
        >
          💻 {t.categories.website} ({categoryCounts.website})
        </button>
        <button 
          type="button"
          data-filter="study-case" 
          class="portfolio-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all cursor-pointer"
        >
          📋 {t.categories.studyCase} ({categoryCounts['study-case']})
        </button>
        <button 
          type="button"
          data-filter="seo" 
          class="portfolio-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all cursor-pointer"
        >
          🔍 {t.categories.seo} ({categoryCounts.seo})
        </button>
        <button 
          type="button"
          data-filter="ads" 
          class="portfolio-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all cursor-pointer"
        >
          🎯 {t.categories.ads} ({categoryCounts.ads})
        </button>
      </div>
    </div>

    <!-- Active Filter Counter Status -->
    <div id="filter-result-counter" class="text-center text-xs text-slate-500 dark:text-slate-400 mb-6 hidden">
      Menampilkan <span id="visible-cards-count" class="font-bold text-indigo-600 dark:text-indigo-400">{categoryCounts.all}</span> dari {categoryCounts.all} proyek
    </div>

    <!-- Empty Results State -->
    <div id="portfolio-empty-state" class="hidden text-center py-16 px-4 glass-card rounded-2xl max-w-lg mx-auto">
      <div class="text-4xl mb-3">🔍</div>
      <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">{t.noResults}</p>
      <button 
        type="button" 
        id="portfolio-reset-btn"
        class="mt-3 px-4 py-2 text-xs font-bold rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 transition-colors cursor-pointer"
      >
        {t.resetFilter}
      </button>
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="portfolio-grid">
      {portfolioData.map((item) => {
        const config = categoryConfig[item.category];
        const description = item.description[currentLang] || item.description.id;
        const searchableContent = `${item.title} ${item.client} ${description} ${(item.techStack || []).join(' ')} ${item.year || ''}`.toLowerCase();
        
        return (
          <article 
            data-category={item.category}
            data-search={searchableContent}
            class="portfolio-card glass-card rounded-2xl border border-slate-200/80 dark:border-white/5 overflow-hidden group reveal-on-scroll flex flex-col justify-between"
          >
            <div>
              {item.category === 'website' && item.thumbnail ? (
                <div class="relative w-full aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-900 border-b border-slate-200/80 dark:border-white/5">
                  <img 
                    src={item.thumbnail} 
                    alt={item.title}
                    loading="lazy"
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-lg backdrop-blur-md bg-slate-900/80 text-white text-[11px] font-bold border border-white/15 shadow-sm">
                    <span>{config.icon}</span>
                    <span>{config.label}</span>
                  </div>
                  {item.year && (
                    <div class="absolute top-3 right-3 px-2 py-0.5 rounded-md backdrop-blur-md bg-slate-900/80 text-slate-200 text-xs font-mono font-semibold border border-white/15">
                      {item.year}
                    </div>
                  )}
                </div>
              ) : (
                <div class="p-5 pb-0 flex items-center justify-between">
                  <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold uppercase tracking-wider border ${config.badgeClass}`}>
                    <span>{config.icon}</span>
                    <span>{config.label}</span>
                  </span>
                  {item.year && (
                    <span class="text-xs font-mono font-semibold text-slate-400 dark:text-slate-500">
                      {item.year}
                    </span>
                  )}
                </div>
              )}

              {/* Card Body */}
              <div class={item.category === 'website' && item.thumbnail ? "p-5" : "p-5 pt-3"}>
                <!-- Title -->
                <h2 class={`text-base sm:text-lg font-bold text-slate-900 dark:text-white ${config.titleHoverClass} transition-colors mb-1.5 leading-snug`}>
                  {item.title}
                </h2>

                <!-- Client -->
                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-3 flex items-center gap-1.5">
                  <span>🏢</span>
                  <span>{item.client}</span>
                </p>

                <!-- Description -->
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
                  {description}
                </p>

                <!-- Tech Stack Chips -->
                {item.techStack && item.techStack.length > 0 && (
                  <div>
                    <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2 font-mono">
                      {t.techStack}
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                      {item.techStack.map((tech) => (
                        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-white/5">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- Card Footer -->
            <div class="px-5 pb-5 pt-0">
              <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800/60 flex items-center justify-between text-xs">
                {item.featured ? (
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">
                    ⭐ Featured
                  </span>
                ) : (
                  <span class="text-[11px] text-slate-400 dark:text-slate-500 font-mono">
                    ID: {item.id}
                  </span>
                )}
                {item.url ? (
                  <a 
                    href={item.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class={`inline-flex items-center gap-1 font-semibold ${config.linkClass} transition-colors`}
                  >
                    <span>{item.category === 'study-case' ? t.viewStudyCase : t.viewProject}</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                ) : (
                  <span class="text-[11px] text-slate-400 dark:text-slate-500 font-medium">
                    {item.category === 'study-case' ? 'Case Study' : 'Verified Work'}
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.portfolio-filter-btn');
  const cards = document.querySelectorAll('.portfolio-card');
  const searchInput = document.getElementById('portfolio-search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('portfolio-search-clear');
  const emptyState = document.getElementById('portfolio-empty-state');
  const resetBtn = document.getElementById('portfolio-reset-btn');
  const counterWrapper = document.getElementById('filter-result-counter');
  const visibleCountEl = document.getElementById('visible-cards-count');

  let activeFilter = 'all';
  let activeQuery = '';

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach(card => {
      const category = card.getAttribute('data-category') || '';
      const searchable = card.getAttribute('data-search') || '';
      
      const matchesCategory = (activeFilter === 'all' || category === activeFilter);
      const matchesSearch = !activeQuery || searchable.includes(activeQuery);

      const el = card as HTMLElement;
      if (matchesCategory && matchesSearch) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    // Update Counter & Empty State
    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
    if (counterWrapper && visibleCountEl) {
      visibleCountEl.textContent = String(visibleCount);
      counterWrapper.classList.toggle('hidden', activeFilter === 'all' && !activeQuery);
    }
    if (searchClear && searchInput) {
      searchClear.classList.toggle('hidden', !searchInput.value);
    }
  }

  // Filter Buttons Click
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-indigo-600', 'dark:bg-indigo-500', 'text-white', 'shadow-md', 'shadow-indigo-500/20');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800/90', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-indigo-600', 'dark:bg-indigo-500', 'text-white', 'shadow-md', 'shadow-indigo-500/20');
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800/90', 'text-slate-700', 'dark:text-slate-300');

      activeFilter = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  // Search Input Real-time Filter
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      activeQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });
  }

  // Clear Search
  if (searchClear && searchInput) {
    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      activeQuery = '';
      applyFilters();
      searchInput.focus();
    });
  }

  // Reset Button in Empty State
  if (resetBtn && searchInput) {
    resetBtn.addEventListener('click', () => {
      searchInput.value = '';
      activeQuery = '';
      activeFilter = 'all';

      // Reset button styles
      filterBtns.forEach(b => {
        const isAll = b.getAttribute('data-filter') === 'all';
        if (isAll) {
          b.classList.add('bg-indigo-600', 'dark:bg-indigo-500', 'text-white', 'shadow-md', 'shadow-indigo-500/20');
          b.classList.remove('bg-slate-100', 'dark:bg-slate-800/90', 'text-slate-700', 'dark:text-slate-300');
        } else {
          b.classList.remove('bg-indigo-600', 'dark:bg-indigo-500', 'text-white', 'shadow-md', 'shadow-indigo-500/20');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800/90', 'text-slate-700', 'dark:text-slate-300');
        }
      });

      applyFilters();
    });
  }
</script>
