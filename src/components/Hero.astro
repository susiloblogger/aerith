---
import { resumeData } from '../data/resume';
---

<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-panel border border-indigo-500/30 text-xs font-semibold text-indigo-600 dark:text-indigo-300 mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
          <span>Open to Strategic Leadership & High-Impact Consulting</span>
        </div>

        <!-- Headline & Name -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] mb-4 text-slate-900 dark:text-white">
          Hi, saya <span class="text-gradient-accent">{resumeData.personal.fullName}</span>
        </h1>

        <p class="text-xl sm:text-2xl font-semibold text-slate-700 dark:text-slate-300 mb-5 leading-snug">
          {resumeData.personal.roleTitle}
        </p>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl mb-8">
          Menggabungkan <strong class="text-slate-900 dark:text-slate-200">10+ tahun strategi pertumbuhan digital berbasis data</strong> (ATL/BTL, SEO, Ads, CRO) dengan keahlian mendalam dalam <strong class="text-slate-900 dark:text-slate-200">arsitektur web modern & UI/UX</strong> untuk mendorong skala bisnis berkelanjutan.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 w-full sm:w-auto mb-10">
          <!-- WhatsApp Primary CTA -->
          <a 
            href={resumeData.personal.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 hover:from-emerald-600 hover:to-cyan-600 text-white font-bold text-sm sm:text-base shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:-translate-y-0.5 transition-all duration-200"
          >
            <!-- WhatsApp Icon -->
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Hubungi via WhatsApp</span>
          </a>

          <!-- Email Quick Copy Button -->
          <button 
            id="copy-email-btn"
            data-email={resumeData.personal.email}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/90 dark:hover:bg-slate-700/90 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700 font-semibold text-sm transition-all shadow-sm"
          >
            <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span id="copy-text">Salin Email</span>
          </button>

          <!-- Explore Experience link -->
          <a 
            href="#experience"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-xl hover:bg-slate-100 dark:hover:bg-white/5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white text-sm font-medium transition-all"
          >
            <span>Lihat Track Record</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Quick Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 w-full pt-6 border-t border-slate-200 dark:border-slate-800/80">
          {resumeData.metrics.map((metric) => (
            <div class="glass-card p-3 sm:p-4 rounded-xl text-left border border-slate-200 dark:border-white/5">
              <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                {metric.value}
              </div>
              <div class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 mt-0.5">
                {metric.label}
              </div>
              <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-tight">
                {metric.description}
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Interactive Profile Card (5 Cols) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end relative">
        
        <!-- Glow Backlight -->
        <div class="absolute -inset-2 bg-gradient-to-tr from-indigo-500/20 via-cyan-500/20 to-purple-500/20 rounded-3xl blur-2xl opacity-75"></div>
        
        <div class="relative w-full max-w-md glass-card rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-white/10 shadow-2xl flex flex-col items-center text-center">
          
          <!-- Avatar with Gradient Ring -->
          <div class="relative mb-6">
            <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl p-1.5 bg-gradient-to-br from-indigo-500 via-cyan-400 to-purple-500 shadow-xl">
              <img 
                src={resumeData.personal.avatarUrl} 
                alt={resumeData.personal.fullName}
                class="w-full h-full object-cover object-[center_20%] rounded-xl" 
              />
            </div>
            
            <!-- Floating Badge 1: 10+ Years -->
            <div class="absolute -bottom-3 -left-3 glass-panel px-3 py-1.5 rounded-xl border border-indigo-500/40 text-xs font-bold text-slate-900 dark:text-white shadow-lg flex items-center gap-1.5">
              <span class="text-amber-500 dark:text-amber-400">⚡</span>
              <span>10+ Yrs Growth Lead</span>
            </div>

            <!-- Floating Badge 2: Google Certified -->
            <div class="absolute -top-3 -right-3 glass-panel px-3 py-1.5 rounded-xl border border-cyan-500/40 text-xs font-bold text-cyan-600 dark:text-cyan-300 shadow-lg flex items-center gap-1.5">
              <span>🎓</span>
              <span>Google Certified</span>
            </div>
          </div>

          <!-- Name & Title on Card -->
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
            {resumeData.personal.fullName}
          </h2>
          <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1 mb-4">
            {resumeData.personal.location} • {resumeData.personal.educationLevel}
          </p>

          <!-- Skills Chips -->
          <div class="flex flex-wrap justify-center gap-1.5 mb-6">
            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-300 border border-indigo-500/20">Growth & CRO</span>
            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border border-cyan-500/20">Google Ads & SEO</span>
            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-violet-500/10 text-violet-700 dark:text-violet-300 border border-violet-500/20">Modern Web Tech</span>
            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">Data & BigQuery</span>
          </div>

          <!-- Quick Contact Actions -->
          <div class="w-full grid grid-cols-2 gap-2 pt-4 border-t border-slate-200 dark:border-slate-800">
            <a 
              href={`tel:${resumeData.personal.phone.replace(/\s+/g, '')}`}
              class="py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/80 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium border border-slate-200 dark:border-slate-700/60 flex items-center justify-center gap-1.5 transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Telepon</span>
            </a>
            <a 
              href={`mailto:${resumeData.personal.email}`}
              class="py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/80 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium border border-slate-200 dark:border-slate-700/60 flex items-center justify-center gap-1.5 transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-indigo-500 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
              <span>Kirim Email</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<script>
  // Copy email interactive toast
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email') || '';
    try {
      await navigator.clipboard.writeText(email);
      if (copyText) copyText.textContent = 'Email Tersalin! ✓';
      copyBtn.classList.add('bg-emerald-100', 'dark:bg-emerald-800/90', 'border-emerald-500', 'text-emerald-700', 'dark:text-emerald-200');
      
      setTimeout(() => {
        if (copyText) copyText.textContent = 'Salin Email';
        copyBtn.classList.remove('bg-emerald-100', 'dark:bg-emerald-800/90', 'border-emerald-500', 'text-emerald-700', 'dark:text-emerald-200');
      }, 2500);
    } catch (err) {
      window.location.href = `mailto:${email}`;
    }
  });
</script>
