---
import { resumeData } from '../data/resume';
import { translations, type Locale } from '../data/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  currentLang?: Locale;
}

const { currentLang = 'id' } = Astro.props;
const t = translations[currentLang].nav;

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en' || Astro.url.pathname === '/en/';
const homeBase = currentLang === 'en' ? '/en/' : '/';
const portfolioUrl = currentLang === 'en' ? '/en/portfolio' : '/portfolio';

const navItems = [
  { href: isHome ? '#about' : `${homeBase}#about`, num: '01', label: t.about, icon: '👤' },
  { href: isHome ? '#skills' : `${homeBase}#skills`, num: '02', label: t.proficiencies, icon: '⚡' },
  { href: isHome ? '#experience' : `${homeBase}#experience`, num: '03', label: t.experience, icon: '💼' },
  { href: portfolioUrl, num: '04', label: t.portfolio, icon: '📁' },
  { href: isHome ? '#certifications' : `${homeBase}#certifications`, num: '05', label: t.certifications, icon: '🎓' },
  { href: isHome ? '#education' : `${homeBase}#education`, num: '06', label: t.education, icon: '📚' },
  { href: isHome ? '#contact' : `${homeBase}#contact`, num: '07', label: t.contact, icon: '✉️' },
];
---

<header class="sticky top-0 z-50 w-full glass-nav backdrop-blur-xl transition-all duration-300 border-b border-slate-200/80 dark:border-white/5">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-18">
      
      <!-- Left: Hamburger Menu Button (Replaces avatar, name, and status badge) -->
      <button 
        id="hamburger-btn" 
        aria-label="Buka navigasi menu"
        aria-expanded="false"
        class="group flex items-center gap-2 h-9 px-3 rounded-xl bg-slate-100/90 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200/80 dark:border-slate-700/60 text-slate-800 dark:text-slate-100 transition-all font-semibold text-xs shadow-xs focus:outline-none hover:border-indigo-500/40 cursor-pointer shrink-0"
      >
        <div class="w-4 h-3 flex flex-col justify-between" id="hamburger-bars">
          <span class="w-4 h-0.5 bg-current rounded-full transition-all duration-200"></span>
          <span class="w-3 h-0.5 bg-current rounded-full transition-all duration-200 group-hover:w-4"></span>
          <span class="w-4 h-0.5 bg-current rounded-full transition-all duration-200"></span>
        </div>
        <span class="font-bold tracking-wider uppercase text-[11px] text-slate-700 dark:text-slate-300 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Menu</span>
      </button>

      <!-- Right Utility Toolbar -->
      <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
        
        <!-- Language Switcher (ID / EN) -->
        <LanguageToggle currentLang={currentLang} />

        <!-- Theme Toggle Switcher (Light / Dark / Device) -->
        <ThemeToggle />

        <!-- Direct Contact WhatsApp CTA (Hidden on Mobile) -->
        <a 
          href={resumeData.personal.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center h-9 px-3.5 sm:px-4 text-xs sm:text-sm font-semibold rounded-xl bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-600 hover:to-cyan-600 text-white shadow-md shadow-indigo-500/20 hover:shadow-indigo-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all whitespace-nowrap gap-1.5 shrink-0"
        >
          <span>{t.contactBtn}</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

      </div>

    </div>
  </div>
</header>

<!-- Slide-over Backdrop Overlay -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<!-- Slide-over Drawer Menu (Opens from the Left) -->
<aside 
  id="drawer-panel"
  aria-label="Menu navigasi utama"
  class="fixed top-0 left-0 bottom-0 w-[84vw] max-w-xs sm:max-w-sm bg-white/95 dark:bg-[#0A0E17]/95 backdrop-blur-2xl z-50 border-r border-slate-200 dark:border-white/10 shadow-2xl flex flex-col justify-between p-5 sm:p-7 -translate-x-full transition-transform duration-300 ease-out"
>
  <!-- Drawer Header -->
  <div>
    <div class="flex items-center justify-between pb-5 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl overflow-hidden border border-indigo-500/30 shrink-0">
          <img 
            src={resumeData.personal.avatarUrl} 
            alt={resumeData.personal.fullName}
            class="w-full h-full object-cover object-[center_20%]" 
          />
        </div>
        <div>
          <h2 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white leading-tight">
            {resumeData.personal.fullName}
          </h2>
          <div class="flex items-center gap-1.5 mt-0.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">{t.status}</span>
          </div>
        </div>
      </div>

      <!-- Close Button (X) -->
      <button 
        id="drawer-close-btn"
        aria-label="Tutup menu"
        class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links List -->
    <nav class="py-5 space-y-1.5">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class="drawer-nav-link group flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-white/5 transition-all text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-white"
        >
          <div class="flex items-center gap-3">
            <span class="text-sm opacity-80 group-hover:scale-110 transition-transform">{item.icon}</span>
            <span class="text-sm font-semibold">{item.label}</span>
          </div>
          <span class="text-xs font-mono text-slate-400 group-hover:text-indigo-500 dark:group-hover:text-indigo-400 font-bold transition-colors">
            {item.num} //
          </span>
        </a>
      ))}
    </nav>
  </div>

  <!-- Drawer Footer Actions -->
  <div class="pt-5 border-t border-slate-200 dark:border-slate-800 space-y-2.5">
    <!-- WhatsApp Direct Button -->
    <a 
      href={resumeData.personal.whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>{t.contactBtn} via WhatsApp</span>
    </a>

    <!-- PDF Print Button -->
    <button 
      onclick="window.print()" 
      class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-xs border border-slate-200 dark:border-slate-700/60 transition-colors cursor-pointer"
    >
      <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
      </svg>
      <span>{t.printBtn}</span>
    </button>
  </div>
</aside>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const closeBtn = document.getElementById('drawer-close-btn');
  const drawerPanel = document.getElementById('drawer-panel');
  const drawerBackdrop = document.getElementById('drawer-backdrop');
  const navLinks = document.querySelectorAll('.drawer-nav-link');

  const openDrawer = () => {
    drawerBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
    drawerBackdrop?.classList.add('opacity-100');
    drawerPanel?.classList.remove('-translate-x-full');
    hamburgerBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeDrawer = () => {
    drawerBackdrop?.classList.add('opacity-0', 'pointer-events-none');
    drawerBackdrop?.classList.remove('opacity-100');
    drawerPanel?.classList.add('-translate-x-full');
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  hamburgerBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  drawerBackdrop?.addEventListener('click', closeDrawer);

  // Close when clicking any nav link in drawer
  navLinks.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>
