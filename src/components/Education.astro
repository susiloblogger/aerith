---
import { resumeData } from '../data/resume';
---

<section id="education" class="py-20 relative border-t border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 text-xs font-bold uppercase tracking-widest mb-3 border border-amber-500/20">
        Academic & Leadership
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Pendidikan Formal & <span class="text-gradient-accent">Kepemimpinan Organisasi</span>
      </h2>
      <p class="text-slate-400 mt-3 text-base sm:text-lg">
        Landasan akademis teknik informatika yang kuat dan rekam jejak kepemimpinan mahasiswa & sosial.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Formal Education Column (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <h3 class="text-xl font-bold text-white flex items-center gap-2 mb-4">
          <span class="p-2 rounded-xl bg-amber-500/20 text-amber-400 text-sm">🎓</span>
          <span>Pendidikan Formal</span>
        </h3>

        <!-- Degree Card: Universitas Bhayangkara -->
        <div class="glass-card p-6 sm:p-7 rounded-2xl border border-white/5 reveal-on-scroll">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <div>
              <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">
                Sarjana Teknik (S.T.)
              </span>
              <h4 class="text-xl font-bold text-white mt-1">
                Universitas Bhayangkara Jakarta Raya
              </h4>
              <p class="text-sm font-semibold text-slate-300">
                Teknik Informatika / Information Technology
              </p>
            </div>
            <div class="text-xs font-bold text-slate-400 px-3 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 self-start sm:self-auto">
              2004 – 2009
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between">
            <div class="text-xs text-slate-400">
              Indeks Prestasi Kumulatif (IPK):
            </div>
            <div class="px-3 py-1 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-extrabold text-sm">
              3.17 / 4.00
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-3 leading-relaxed">
            Fokus kurikulum pada arsitektur sistem informasi, algoritma pemrograman, perancangan database relasional, serta manajemen jaringan komputer.
          </p>
        </div>

        <!-- Vocational Card: SMK Bina Teknologi -->
        <div class="glass-card p-5 rounded-2xl border border-white/5 reveal-on-scroll">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h4 class="text-base font-bold text-white">
                SMK Bina Teknologi Purwokerto
              </h4>
              <p class="text-xs text-slate-400 mt-0.5">
                Teknik Mesin (Mechanical Engineering)
              </p>
            </div>
            <div class="text-xs font-bold text-slate-400 px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 self-start sm:self-auto">
              2000 – 2003
            </div>
          </div>
        </div>

        <!-- Non-formal: English Proficiency -->
        <div class="glass-panel p-5 rounded-2xl border border-white/5">
          <h4 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
            <span>🌐</span> Kemahiran Bahasa & Pelatihan Bahasa Inggris
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-300">
            <div class="p-3 rounded-xl bg-slate-800/50 border border-slate-700/40">
              <div class="font-semibold text-white">Yayasan LIA (2022)</div>
              <div class="text-slate-400 mt-0.5">Professional English Communication Course</div>
            </div>
            <div class="p-3 rounded-xl bg-slate-800/50 border border-slate-700/40">
              <div class="font-semibold text-white">Intensive English Course (2003)</div>
              <div class="text-slate-400 mt-0.5">Advanced English Proficiency</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Organizational & Leadership Column (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <h3 class="text-xl font-bold text-white flex items-center gap-2 mb-4">
          <span class="p-2 rounded-xl bg-purple-500/20 text-purple-400 text-sm">👥</span>
          <span>Organisasi & Kepemimpinan</span>
        </h3>

        <div class="space-y-4">
          {resumeData.organizations.map((org) => (
            <div class="glass-card p-5 rounded-2xl border border-white/5 reveal-on-scroll">
              <div class="flex items-start justify-between gap-2 mb-1.5">
                <h4 class="text-sm font-bold text-white leading-snug">
                  {org.role}
                </h4>
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-800 text-slate-300 border border-slate-700/50 shrink-0">
                  {org.year}
                </span>
              </div>
              <p class="text-xs text-indigo-300 font-medium">
                {org.org}
              </p>
            </div>
          ))}
        </div>

        <!-- Social Responsibility Card -->
        <div class="p-5 rounded-2xl bg-gradient-to-br from-indigo-900/30 via-slate-900/40 to-slate-900 border border-indigo-500/20">
          <div class="text-xs font-bold text-indigo-400 uppercase tracking-wider mb-1">
            Nilai Integritas & Kontribusi Sosial
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            Aktif mengaplikasikan keahlian data dan sistem komputerisasi untuk kegiatan sosial dan literasi anak bangsa (Sejuta Buku Untuk Anak Indonesia) serta pembinaan kemahasiswaan.
          </p>
        </div>

      </div>

    </div>

  </div>
</section>
