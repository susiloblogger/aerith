---
import { resumeData } from '../data/resume';
import { translations, type Locale } from '../data/i18n';

interface Props {
  currentLang?: Locale;
}

const { currentLang = 'id' } = Astro.props;
const t = translations[currentLang].experience;
---

<section id="experience" class="py-20 relative border-t border-slate-200 dark:border-slate-800/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-500/10 text-violet-600 dark:text-violet-400 text-xs font-bold uppercase tracking-widest mb-3 border border-violet-500/20">
        {t.badge}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t.title}<span class="text-gradient-accent">{t.titleAccent}</span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-3 text-base sm:text-lg">
        {t.subtitle}
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12" id="exp-filters">
      <button 
        data-filter="all" 
        class="exp-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 dark:bg-indigo-500 text-white shadow-md transition-all"
      >
        {t.filters.all} ({resumeData.experiences.length})
      </button>
      <button 
        data-filter="growth" 
        class="exp-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all"
      >
        {t.filters.growth}
      </button>
      <button 
        data-filter="tech" 
        class="exp-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all"
      >
        {t.filters.tech}
      </button>
      <button 
        data-filter="consulting" 
        class="exp-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all"
      >
        {t.filters.consulting}
      </button>
      <button 
        data-filter="academic" 
        class="exp-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700/60 transition-all"
      >
        {t.filters.academic}
      </button>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative border-l-2 border-slate-200 dark:border-slate-800 ml-4 sm:ml-8 pl-6 sm:pl-10 space-y-10">
      
      {resumeData.experiences.map((exp) => (
        <div 
          data-type={exp.type}
          class="experience-card relative group reveal-on-scroll"
        >
          <!-- Timeline Pin Dot -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-1 w-5 h-5 rounded-full bg-slate-50 dark:bg-[#07090E] border-2 border-indigo-500 group-hover:border-cyan-400 group-hover:scale-125 transition-all duration-300 flex items-center justify-center">
            <div class="w-1.5 h-1.5 rounded-full bg-indigo-500 dark:bg-indigo-400 group-hover:bg-cyan-400"></div>
          </div>

          <!-- Card Content -->
          <div class="glass-card p-6 sm:p-7 rounded-2xl border border-slate-200 dark:border-white/5 group-hover:border-indigo-500/40 transition-all duration-300">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider mb-1.5 ${
                  exp.type === 'growth' ? 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border border-cyan-500/20' :
                  exp.type === 'tech' ? 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20' :
                  exp.type === 'consulting' ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20' :
                  'bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20'
                }">
                  {exp.type.toUpperCase()}
                </span>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-300 transition-colors">
                  {exp.role}
                </h3>
                <div class="text-sm font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-2 mt-0.5">
                  <span>🏢 {exp.company}</span>
                </div>
              </div>

              <!-- Period Pill -->
              <div class="self-start sm:self-auto px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 text-xs font-semibold text-slate-700 dark:text-slate-300">
                📅 {exp.period}
              </div>
            </div>

            <!-- Skills chips if available -->
            {exp.skills && (
              <div class="flex flex-wrap gap-1.5 my-4">
                {exp.skills.map(s => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 dark:bg-white/5 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-white/5">
                    {s}
                  </span>
                ))}
              </div>
            )}

            <!-- Responsibilities List -->
            <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">
              {exp.responsibilities.map((resp) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-indigo-600 dark:text-indigo-400 font-bold shrink-0 mt-0.5">▹</span>
                  <span>{resp}</span>
                </li>
              ))}
            </ul>

          </div>
        </div>
      ))}

    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.exp-filter-btn');
  const cards = document.querySelectorAll('.experience-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-indigo-600', 'dark:bg-indigo-500', 'text-white');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800/90', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-indigo-600', 'dark:bg-indigo-500', 'text-white');
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800/90', 'text-slate-700', 'dark:text-slate-300');

      const filter = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const type = card.getAttribute('data-type');
        if (filter === 'all' || type === filter) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
