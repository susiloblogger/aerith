---
// ThemeToggle.astro: Light, Dark, or System theme switcher
---

<div class="relative inline-block text-left" id="theme-menu-wrapper">
  <!-- Trigger Button -->
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Ubah tema tampilan"
    class="h-9 px-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 transition-all flex items-center justify-center gap-1.5 focus:outline-none shadow-xs"
  >
    <!-- Sun Icon (Light) -->
    <svg id="icon-sun" class="w-4 h-4 hidden text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <!-- Moon Icon (Dark) -->
    <svg id="icon-moon" class="w-4 h-4 hidden text-indigo-500 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
    <!-- Laptop / System Icon (Device) -->
    <svg id="icon-system" class="w-4 h-4 hidden text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>

    <!-- Caret -->
    <svg class="w-3 h-3 text-slate-400 transition-transform duration-200" id="theme-caret" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="theme-dropdown"
    class="hidden absolute right-0 mt-2 w-44 rounded-2xl glass-panel bg-white/95 dark:bg-[#0D131F]/95 border border-slate-200 dark:border-white/10 shadow-xl py-1.5 z-50 text-xs font-semibold backdrop-blur-xl transition-all"
  >
    <button
      type="button"
      data-theme-value="light"
      class="theme-option w-full px-3.5 py-2.5 flex items-center justify-between text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
    >
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span>Mode Terang</span>
      </span>
      <span class="check-mark hidden text-indigo-500 dark:text-indigo-400">✓</span>
    </button>

    <button
      type="button"
      data-theme-value="dark"
      class="theme-option w-full px-3.5 py-2.5 flex items-center justify-between text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
    >
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span>Mode Gelap</span>
      </span>
      <span class="check-mark hidden text-indigo-500 dark:text-indigo-400">✓</span>
    </button>

    <div class="h-px bg-slate-200 dark:bg-white/10 my-1"></div>

    <button
      type="button"
      data-theme-value="system"
      class="theme-option w-full px-3.5 py-2.5 flex items-center justify-between text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
    >
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Sesuai Device</span>
      </span>
      <span class="check-mark hidden text-indigo-500 dark:text-indigo-400">✓</span>
    </button>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('theme-toggle-btn');
  const dropdown = document.getElementById('theme-dropdown');
  const caret = document.getElementById('theme-caret');
  const sunIcon = document.getElementById('icon-sun');
  const moonIcon = document.getElementById('icon-moon');
  const systemIcon = document.getElementById('icon-system');
  const options = document.querySelectorAll('.theme-option');

  const getSavedPreference = () => {
    return localStorage.getItem('theme') || 'system';
  };

  const applyTheme = (pref: string) => {
    const isSystemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = pref === 'dark' || (pref === 'system' && isSystemDark);

    if (isDark) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }

    // Update active icon on button
    sunIcon?.classList.add('hidden');
    moonIcon?.classList.add('hidden');
    systemIcon?.classList.add('hidden');

    if (pref === 'light') {
      sunIcon?.classList.remove('hidden');
    } else if (pref === 'dark') {
      moonIcon?.classList.remove('hidden');
    } else {
      systemIcon?.classList.remove('hidden');
    }

    // Update check marks
    options.forEach(opt => {
      const val = opt.getAttribute('data-theme-value');
      const check = opt.querySelector('.check-mark');
      if (val === pref) {
        check?.classList.remove('hidden');
        opt.classList.add('font-bold', 'text-indigo-600', 'dark:text-indigo-400');
      } else {
        check?.classList.add('hidden');
        opt.classList.remove('font-bold', 'text-indigo-600', 'dark:text-indigo-400');
      }
    });
  };

  // Toggle Dropdown
  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('hidden');
    caret?.classList.toggle('rotate-180');
  });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (!document.getElementById('theme-menu-wrapper')?.contains(e.target as Node)) {
      dropdown?.classList.add('hidden');
      caret?.classList.remove('rotate-180');
    }
  });

  // Option selection
  options.forEach(opt => {
    opt.addEventListener('click', () => {
      const val = opt.getAttribute('data-theme-value') || 'system';
      localStorage.setItem('theme', val);
      applyTheme(val);
      dropdown?.classList.add('hidden');
      caret?.classList.remove('rotate-180');
    });
  });

  // System theme change listener
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getSavedPreference() === 'system') {
      applyTheme('system');
    }
  });

  // Initialize UI state
  applyTheme(getSavedPreference());
</script>
