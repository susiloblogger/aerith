---
import { resumeData } from '../data/resume';
import { translations, type Locale } from '../data/i18n';

interface Props {
  currentLang?: Locale;
}

const { currentLang = 'id' } = Astro.props;
const t = translations[currentLang].about;
---

<section id="about" class="py-20 relative border-t border-slate-200 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-widest mb-3 border border-indigo-500/20">
        {t.badge}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t.title}<span class="text-gradient-accent">{t.titleAccent}</span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-3 text-base sm:text-lg">
        {t.subtitle}
      </p>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left: Story Narrative (7 Cols) -->
      <div class="lg:col-span-7 glass-panel p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-white/5 space-y-5 reveal-on-scroll">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2.5">
          <span class="p-2 rounded-xl bg-indigo-500/10 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-sm">💡</span>
          <span>{t.philosophyTitle}</span>
        </h3>

        <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
          {t.p1}
        </p>

        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
          {t.p2}
        </p>

        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
          {t.p3}
        </p>

        <!-- Key Milestones Strip -->
        <div class="pt-4 border-t border-slate-200 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 font-bold shrink-0 text-sm">
              ✓
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-900 dark:text-white">{t.milestone1Title}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">{t.milestone1Desc}</div>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-600 dark:text-cyan-400 font-bold shrink-0 text-sm">
              ✓
            </div>
            <div>
              <div class="text-sm font-semibold text-slate-900 dark:text-white">{t.milestone2Title}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">{t.milestone2Desc}</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right: Three Strategic Pillars (5 Cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Pillar 1 -->
        <div class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-white/5 reveal-on-scroll">
          <div class="flex items-center gap-3 mb-2">
            <div class="p-2.5 rounded-xl bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-base">{t.pillar1Title}</h4>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t.pillar1Desc}
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-white/5 reveal-on-scroll">
          <div class="flex items-center gap-3 mb-2">
            <div class="p-2.5 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-base">{t.pillar2Title}</h4>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t.pillar2Desc}
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-white/5 reveal-on-scroll">
          <div class="flex items-center gap-3 mb-2">
            <div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-base">{t.pillar3Title}</h4>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t.pillar3Desc}
          </p>
        </div>

      </div>

    </div>

  </div>
</section>
